# Copy this file to .env and fill in your credentials
# cp .env.example .env

# ─── Required ────────────────────────────────────────────────────────────────

# IBM Cloud API Key
# Obtain from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your-ibm-cloud-api-key-here

# watsonx.ai Project ID
# Obtain from: watsonx.ai → your project → Manage → General → Project ID
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# ─── Optional ────────────────────────────────────────────────────────────────

# watsonx.ai service URL (default: Dallas / us-south)
# For Frankfurt: https://eu-de.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
